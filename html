<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reparos de Micros</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <div class="container-1">
            <a href="#"><img src="imgs/logo.jpg" class="home" alt=""></a>
            <div class="txt">
                <h1>BG Reparos</h1>
                <p>Reparo de micros e manutenção de redes</p>
            </div>
            <a href="#"><img src="imgs/wpp.png" class="wpp" alt=""></a>
        </div>
    </header>
    <main>
        <div class="container-2">
            <h1>Manutenção e Suporte em Informática</h1>
            <h3>Seu computador mais rápido sem dor de cabeça</h3>
            <button class="botao-orcamento">Solicitar orçamento</button>
        </div>
        <div class="container-3">
            <h2>Selecione um serviço:</h2>
            <form>
                <div class="container-31">
                    <input type="checkbox" id="pcs" value="PCs">
                    <label for="pcs">PCs</label>
                    <input type="checkbox" id="wifi" value="Wi-Fi">
                    <label for="wifi">Wi-Fi</label>
                    <input type="checkbox" id="impressoras" value="Impressoras">
                    <label for="impressoras">Impressoras</label>
                </div>
                <div class="container-32">
                    <input type="checkbox" id="ssd" value="SSD">
                    <label for="ssd">SSD</label>
                    <input type="checkbox" id="memoria" value="Memória">
                    <label for="memoria">Memória</label>
                    <input type="checkbox" id="videoconferencia" value="Videoconferência">
                    <label for="videoconferencia">Videoconferência</label>
                </div>
                <button class="enviar">Enviar</button>
            </form>
        </div>
    </main>
    <footer></footer>
</body>
</html>
