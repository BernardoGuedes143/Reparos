*{
    margin:0;
    padding: 0;
}

body{
    display: block;
}

main{
    margin-top: 200px;
    display: flex;
    flex-direction: column;
    height: 2000px;
    
}

.container-1{
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: 0px 10px 0px 10px;
    display: flex;
    justify-content: space-between;
    border: 2px dotted;
    padding: 1%;
    z-index: 2;
    background: #adff2f;
}

.container-2{
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-align: center;
    align-items: center;
    border-bottom: 1px dashed black;
}

.container-3{
    margin-top: 50px;
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 20px;
}

.container-31{
    display: inline-block;
    
}

.container-32{
    display: inline-block;
}

form{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
}

.home{
    height: 100px;
    width: 150px;
    background-image: url('../imgs/logo.jpg');
    background-size: cover;
    cursor: pointer;
    border: none;
}

.wpp{
    height: 100px;
    width: 100px;
    cursor: pointer;
    border: none;
}

.txt{
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 20px;
}


.botao-orcamento{
    width: 100px;
    margin-bottom: 2%;
}

h2{
    margin-bottom: 2%;
}



button{
    width: 150px;
    cursor: pointer;
}
