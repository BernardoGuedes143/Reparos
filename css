*{
    margin:0;
    padding: 0;
}

.container-1{
    display: flex;
    justify-content: space-between;
    border: 2px dotted;
    padding: 1%;
}

.home{
    height: 100px;
    width: 150px;
    background-image: url('../imgs/logo.jpg');
    background-size: cover;
    cursor: pointer;
    border: none;
}

.wpp{
    height: 100px;
    width: 100px;
    background-image: url('../imgs/wpp.png');
    background-size: cover;
    cursor: pointer;
    border: none;
}

.txt{
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 20px;
}
